# Copy to .env and fill in. .env is gitignored — never commit it.

# Required by SEC EDGAR fair-access policy: "Name email@domain"
EDGAR_USER_AGENT="Your Name your.email@example.com"

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: only if tracing.backend = langfuse in config/settings.yaml
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
