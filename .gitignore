# Data: raw downloads, processed artifacts and caches are reproducible -> not committed.
# data/gold/ (hand-labeled evaluation data) IS committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/

